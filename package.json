{
  "name": "js-dev-docs-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "inventory:content": "node scripts/extract-legacy-navigation.mjs",
    "migrate:content": "node scripts/migrate-legacy-content.mjs",
    "build:search": "node scripts/build-search-index.mjs",
    "generate:translations": "node scripts/generate-translation-stubs.mjs",
    "validate:migration": "node scripts/validate-migration.mjs",
    "predev": "npm run migrate:content && npm run build:search",
    "prebuild": "npm run migrate:content && npm run build:search && npm run validate:migration"
  },
  "dependencies": {
    "next": "^15.3.0",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
